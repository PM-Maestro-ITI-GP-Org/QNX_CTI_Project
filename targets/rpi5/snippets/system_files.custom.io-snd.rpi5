# RPI5 files related to io-snd
#
# These might one day be included automatically by mkqnximage
# but at the moment that isn't the case.
#

###########################################################################
## io-snd drivers
###########################################################################
# No RPI5 specific drivers yet, left the RPI4 ones commented out below
# as a reference for what to expect in the future
#/lib/dll/sndrv-ctrl-bcm2711_pcm.so=lib/dll/sndrv-ctrl-bcm2711_pcm.so
#/lib/dll/sndrv-ctrl-bcm2711_pwm.so=lib/dll/sndrv-ctrl-bcm2711_pwm.so
