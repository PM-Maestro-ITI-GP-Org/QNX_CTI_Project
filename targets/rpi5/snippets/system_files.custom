################################################################
# USB support
################################################################
etc/usb_start.sh = {
  echo "Starting USB xHCI controller in the host mode (/dev/usb/*)..."

  # Enable RP1 MSIX USB2/USB3 interrupts
  msix-rp1 --mode=config 31e,36e
  gpio-rp1 set 42 a2 pn
  gpio-rp1 set 43 a2 pu

  /system/sbin/io-usb-otg -v -d dwc3-xhci ioport=0x1f00200000,irq=0xbf,iosize=0x100000,bmstr=0x1000000000,ioport=0x1f00300000,irq=0xc4,iosize=0x100000,bmstr=0x1000000000
  waitfor /dev/usb/io-usb-otg 10
}
/lib/dll/devu-hcd-dwc3-xhci.so=lib/dll/devu-hcd-dwc3-xhci.so
/lib/libhiddi.so=lib/libhiddi.so
/lib/libusbdi.so.2=lib/libusbdi.so.2
[type=link] lib/libusbdi.so=libusbdi.so.2
/lib/libusbdi.so=lib/libusbdi.so
/sbin/io-usb-otg=sbin/io-usb-otg
/sbin/usb=sbin/usb
/sbin/devb-umass=sbin/devb-umass
/lib/libusbdci.so=lib/libusbdci.so


