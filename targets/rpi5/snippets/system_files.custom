################################################################
# RPi HW support
################################################################
bin/gpio-aon-bcm=bin/gpio-aon-bcm
bin/gpio-bcm=bin/gpio-bcm
bin/gpio-rp1=bin/gpio-rp1
bin/mbox-bcm=bin/mbox-bcm
bin/msix-rp1=bin/msix-rp1
[type=file uid=0 gid=0 perms=0755] bin/rpi_mbox=sbin/rpi_mbox
[type=file uid=0 gid=0 perms=0755] bin/rpi_thermal=sbin/rpi_thermal
sbin/fan-rpi5=sbin/fan-rpi5
bin/i2c-dwc-rpi5=sbin/i2c-dwc-rpi5

bin/spi-dwc=sbin/spi-dwc
etc/config/spi/spi.conf=etc/config/spi/spi.conf
etc/spi.conf = {
# See spi-template.conf or SDP docs for a full description of the configuration fields.

[globals]
verbose=5

[bus]
busno=0
name=spi0
base=0x1f00050000
irq=179
input_clock=200000000
bs=cs_max=1

[dev]
parent_busno=0
devno=0
name=dev0
clock_rate=100000000
cpha=1
cpol=0
bit_order=msb
word_width=32
idle_insert=1

}

[type=file uid=0 gid=0 perms=0755] bin/rpi_thermal=sbin/rpi_thermal

