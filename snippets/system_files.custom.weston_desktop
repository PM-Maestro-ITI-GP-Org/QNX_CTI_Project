# Configuration for weston / XFCE desktop

# Images
[type=file uid=0 gid=0 perms=0444] share/backgrounds/qnx/=backgrounds/local/desktop

[type=file uid=0 gid=0 perms=0755] bin/startDesktop.sh={
#/bin/bash

unset WAYLAND_DISPLAY

export XDG_RUNTIME_DIR=/var/run/user/$(id -u)
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state
export XDG_DATA_DIRS=/usr/share
export XDG_MENU_PREFIX=xfce-
export XDG_SESSION_TYPE=wayland
export SDL_VIDEODRIVER=wayland
export SDL_VIDEO_DRIVER=wayland
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export GSK_RENDERER=cairo
export __GL_SHADER_CACHE=1
export GDK_GL=gles

RUNNING_INSTANCE=$(pidin ar | grep "dbus-run-session" | grep -v "grep")

if [[ -n $RUNNING_INSTANCE ]]; then
  echo "WARNING: Desktop is already running."
  echo "Only one instance of the desktop is allowed at a time."
  exit 1
else
    dbus-run-session -- /usr/bin/weston --fullscreen &
fi
}

bin/loginctl=usr/bin/loginctl
bin/make_custom_target=usr/bin/make_custom_target
