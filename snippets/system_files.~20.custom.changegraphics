# update the gui Config file

lib/graphics/drm-rpi5/graphics-rpi5-2xhdmi.conf = {
begin khronos
  begin egl display 1
    egl-dlls = v3d_dri.so EGL-mesa.so
    glesv2-dlls = v3d_dri.so GLESv2-mesa.so
    gpu-dlls = v3d_dri.so gpu_rpi5.so
    vk-icds = broadcom_icd.json
    vk-exps = /usr/lib/graphics/vulkan/VkLayer_khronos_validation.json

    # alloc-surface could have "auto" or "linear" settings. Default is
    # "auto" - linearity is depending on usage flags, "linear" - all
    # allocations are linear.
    alloc-surface = auto
  end egl display

  begin wfd device 3
    wfd-dlls = libwfdcfg-rpi5.so libWFDrpi5.so
    display-ids = 1, 2
  end wfd device
end khronos

begin winmgr
  begin globals
    default-display = 1
    stack-size = 262144
    blit-config = gles2blt
    alloc-config = alloc-rpi5
  end globals

  begin display 1
    video-mode = 1280 x 720 @ 60
    stack-size = 262144
    defer-framebuffer-creation = false
    force-composition = true
   end display

  begin display 2
    video-mode = 1280 x 720 @ 60
    stack-size = 262144
    defer-framebuffer-creation = false
    force-composition = true
   end display

  begin class framebuffer-1
    display = 1
    pipeline = 100
    format = rgba8888
    usage = gles2blt
  end class

  begin class framebuffer-2
    display = 2
    pipeline = 200
    format = rgba8888
    usage = gles2blt
  end class

end winmgr
}