[uid=0 gid=0 perms=0444] __PCI_RPI5_HW_CONFIG_FILE__ = {
######################################  S E C T I O N  #########################################
##
[PI5]
##
## Pi 5 PCIe HW module configuration
## --------------------------------
##

## PCIe gen speed configuration for the extension port
MAX_GEN_SPEED=3
}
[type=link] pci_hw.cfg=__PCI_RPI5_HW_CONFIG_FILE__

