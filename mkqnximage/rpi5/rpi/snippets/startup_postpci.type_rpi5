echo "Executing post PCI startup sequence"

# Enable RP1's PCI MSIX link
# This doesn't actually configure any MSIX Interrupts.
# That is done later with subsequent calls to msix-rp1
# as required for specific HW.
toybox sleep 1
msix-rp1 --mode=server &

# Not strictly related to PCI, but this has to be done before
# networking is started and this is a convenient place for that.
#
# Enable RP1's MSIX ETH IRQ
msix-rp1 --mode=config 6
# config ETH_RST_N/GPIO32 pin
gpio-rp1 set 32 op pd dh

