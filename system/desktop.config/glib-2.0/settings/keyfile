[org/gnome/desktop/sound]
event-sounds=false
input-feedback-sounds=false
theme-name='default'

[org/gnome/desktop/peripherals/mouse]
double-click=400
drag-threshold=8

[org/gnome/desktop/wm/preferences]
button-layout='icon,menu:minimize,maximize,close'
action-middle-click-titlebar='lower'

[org/gnome/desktop/interface]
gtk-theme='Adwaita'
icon-theme='nuoveXT2'
gtk-key-theme=''
cursor-blink=true
cursor-blink-time=1200
cursor-size=0
cursor-theme=''
font-name='Onest 10'

[org/gnome/gthumb/general]
active-extensions=['23hq', 'bookmarks', 'burn_disc', 'catalogs', 'change_date', 'comments', 'contact_sheet', 'convert_format', 'desktop_background', 'edit_metadata', 'exiv2_tools', 'file_manager', 'find_duplicates', 'flicker', 'gstreamer_tools', 'gstreamer_utils', 'image_print', 'image_rotation', 'importer', 'jpeg_utils', 'list_tools', 'oauth', 'photo_importer', 'raw_files', 'red_eye_removal', 'rename_series', 'resize_images', 'search', 'selections', 'slideshow', 'terminal', 'webalbums']

[org/gnome/gthumb/browser]
thumbnail-list-visible=true
statusbar-visible=true
sidebar-visible=true
properties-visible=false
window-width=1027
window-height=576
maximized=false
browser-sidebar-width=285
viewer-sidebar='tools'
fullscreen-sidebar='hidden'
fullscreen-thumbnails-visible=false
sidebar-sections=['GthFileProperties:expanded', 'GthFileComment:expanded', 'GthFileDetails:expanded', 'GthImageHistogram:expanded']
startup-location='file:///usr/share/backgrounds/qnx'
startup-current-file='file:///usr/share/backgrounds/qnx/background_auto_robotics_720p.png'
sort-type='file::mtime'
sort-inverse=false
folder-tree-sort-type='name'
folder-tree-sort-inverse=false

[org/gnome/gthumb/data-migration]
catalogs-2-10=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/qnx/background_auto_robotics_720p.png'
picture-uri-dark='file:///usr/share/backgrounds/qnx/background_auto_robotics_720p.png'
picture-options='zoom'

[org/gtk/settings/file-chooser]
window-position=(26, 23)
window-size=(1096, 623)
date-format='regular'
location-mode='path-bar'
show-hidden=false
show-size-column=true
show-type-column=true
sidebar-width=155
sort-column='name'
sort-directories-first=false
sort-order='ascending'
type-format='category'

[org/gnome/gthumb/pixbuf-savers/png]
compression-level=9

[org/gnome/gthumb/dialogs/save-file]
show-options=true

[org/mate/calc]
source-units='degree'
target-units='radian'
show-history=false
button-mode='basic'

[org/gnome/epiphany/state]
window-size=(1024, 768)
is-maximized=false

[org/gnome/epiphany/web]
default-zoom-level=1.0
hardware-acceleration-policy=always
keyword-search-url=www.google.com
ask-on-download=true

[org/gnome/epiphany]
search-engine-providers=[{'url': <'https://www.bing.com/search?q=%s'>, 'bang': <'!b'>, 'name': <'Bing'>}, {'url': <'https://duckduckgo.com/?q=%s&t=epiphany'>, 'bang': <'!ddg'>, 'name': <'DuckDuckGo'>}, {'url': <'https://www.google.com/search?q=%s'>, 'bang': <'!g'>, 'name': <'Google'>}]
default-search-engine='Google'
homepage-url='https://qnx.software/en/developers/get-started/qnx-everywhere'
